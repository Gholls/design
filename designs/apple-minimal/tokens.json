{
  "meta": {
    "name": "Apple Minimal",
    "slug": "apple-minimal",
    "order": 2,
    "author": "gholl",
    "summary": "苹果式极简：浅灰底、系统字体、大圆角与极柔和的环境阴影，留白即层级。",
    "tags": ["minimal", "apple", "留白", "大圆角"]
  },
  "colors": {
    "bg": "#f5f5f7",
    "surface": "#ffffff",
    "surface-alt": "#fafafa",
    "primary": "#0071e3",
    "primary-strong": "#0060c0",
    "on-primary": "#ffffff",
    "accent": "#5856d6",
    "text": "#1d1d1f",
    "muted": "#86868b",
    "border": "#d2d2d7",
    "success": "#34c759",
    "warning": "#ff9f0a",
    "danger": "#ff3b30"
  },
  "typography": {
    "font-family-base": "-apple-system, 'SF Pro Text', 'PingFang SC', 'Helvetica Neue', ui-sans-serif, system-ui, sans-serif",
    "font-family-display": "-apple-system, 'SF Pro Display', 'PingFang SC', ui-sans-serif, system-ui, sans-serif",
    "font-size-base": "16px",
    "letter-spacing": "-0.022em",
    "heading-weight": "700"
  },
  "rounded": {
    "card": "18px",
    "control": "12px",
    "badge": "9999px"
  },
  "spacing": {
    "scale": "1.08",
    "table-row": "48px"
  },
  "shadows": {
    "card": "0 4px 24px rgb(0 0 0 / 0.06)",
    "control": "0 1px 3px rgb(0 0 0 / 0.08)"
  },
  "strokes": {
    "card": "1px",
    "control": "1px"
  }
}
