{
  "name": "design-gholl-com",
  "private": true,
  "version": "0.1.0",
  "description": "Design.md 互动式设计规范画廊与黄金样板间预览平台",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "design:lint": "node scripts/lint-designs.mjs",
    "generate": "node scripts/generate.mjs",
    "fetch": "node scripts/fetch-designmd.mjs",
    "autofix": "node scripts/lint-autofix.mjs",
    "index": "tsx scripts/build-index.mjs",
    "predev": "npm run index",
    "prebuild": "npm run index",
    "deploy": "npm run build && npx wrangler pages deploy dist --project-name design-gholl-com",
    "postbuild": "node scripts/prerender-meta.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@google/design.md": "^0.4.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "js-yaml": "^5.5.0"
  }
}
